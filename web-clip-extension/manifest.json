{
  "manifest_version": 3,
  "name": "KnowBook Web Clipper",
  "version": "0.1.2",
  "description": "Clip the current page into the local KnowBook desktop app.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Clip to KnowBook",
    "default_popup": "popup.html"
  }
}
