{
  "name": "knowbook",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "description": "Local-first knowledge management client built with Electron, React, TypeScript, and SQLite.",
  "author": "zhenhua32",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhenhua32/knowbook.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && npm run verify:renderer-bundle",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "release": "npm run build && electron-builder --publish always",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:verify-local": "npm run dist && node scripts/release-preflight.mjs --require-artifacts",
    "preview": "electron-vite preview",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx --test --test-timeout=120000 \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:markdown-spec": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/markdown-spec-report.ts",
    "test:synced-exchange-v2-compat": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-synced-exchange-v2.ts",
    "test:synced-exchange-v1-compat": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-synced-exchange-v1.ts",
    "test:schema27-legacy-readers": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-schema27-legacy-readers.ts",
    "verify:renderer-bundle": "node scripts/verify-renderer-bundle.mjs",
    "benchmark:performance": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/performance-benchmark.ts",
    "benchmark:markdown": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/markdown-quality-benchmark.ts",
    "benchmark:markdown-links": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/markdown-link-benchmark.ts",
    "benchmark:markdown-source": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/markdown-source-benchmark.ts",
    "benchmark:synced-source": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/synced-source-checkpoint-benchmark.ts",
    "benchmark:performance:backup": "cross-env KNOWBOOK_BENCHMARK_BACKUP_IO=1 npm run benchmark:performance",
    "test:e2e": "npm run build && playwright test --grep @electron",
    "test:runtime-smoke": "npm run build && electron --no-sandbox --disable-gpu --disable-software-rasterizer --in-process-gpu scripts/quickjs-runtime-smoke.mjs",
    "test:plugin-security": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx --test --test-timeout=120000 tests/main-plugin-platform-quickjs-realm.test.ts tests/main-plugin-platform-capability-broker.test.ts",
    "test:packaged-runtime-smoke": "node scripts/packaged-runtime-smoke.mjs",
    "test:packaged-system-plugins": "node scripts/packaged-system-plugin-smoke.mjs",
    "prepare:host-upgrade": "node scripts/prepare-host-upgrade.mjs",
    "test:packaged-host-upgrade": "node scripts/packaged-host-upgrade.mjs",
    "test:packaged-windows-startup": "node scripts/packaged-windows-startup.mjs",
    "test:packaged-uninstall-cleanup": "node scripts/packaged-uninstall-cleanup.mjs",
    "prepare:windows-installer": "node scripts/prepare-windows-installer.mjs",
    "test:packaged-windows-installer": "node scripts/packaged-windows-installer.mjs",
    "prepare:windows-session": "node scripts/prepare-windows-session-fixture.mjs",
    "capture:windows-session": "node scripts/windows-session-evidence.mjs capture",
    "verify:windows-session": "node scripts/windows-session-evidence.mjs verify",
    "test:packaged-dependency-scripts": "node scripts/packaged-dependency-scripts.mjs",
    "prepare:package-managers": "node scripts/prepare-package-managers.mjs",
    "prepare:modern-yarn": "node scripts/prepare-modern-yarn.mjs",
    "typecheck:system-plugin-examples": "tsc --noEmit -p examples/tsconfig.json",
    "test:packaged-modern-yarn": "node scripts/packaged-modern-yarn.mjs",
    "test:packaged-activation-recovery": "node scripts/packaged-activation-recovery.mjs",
    "test:packaged-data-retention": "node scripts/packaged-data-retention.mjs",
    "test:packaged-database-restore": "node scripts/packaged-database-restore.mjs",
    "test:packaged-install-interruption": "node scripts/packaged-install-interruption.mjs",
    "test:packaged-native-package-managers": "node scripts/packaged-native-package-managers.mjs",
    "prepare:native-package-managers": "node scripts/prepare-native-package-managers.mjs",
    "test:packaged-system-capabilities": "node scripts/packaged-system-capabilities.mjs",
    "test:packaged-package-managers": "node scripts/packaged-package-managers.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "postinstall": "electron-builder install-app-deps",
    "test:synced-exchange-v3-compat": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-synced-exchange-v3.ts",
    "test:synced-tombstone-legacy-readers": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-synced-tombstone-legacy-readers.ts",
    "test:synced-exchange-v4-compat": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-synced-exchange-v4.ts",
    "test:synced-exchange-v56-compat": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-synced-exchange-v56.ts",
    "test:backup-v3-legacy-reader": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-backup-v3-legacy-reader.ts",
    "test:database-restore": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx --test --test-timeout=120000 tests/main-database-restore-maintenance.test.ts tests/main-database-restore-process-query.test.ts tests/main-database-restore-process-json.test.ts tests/main-managed-asset-source.test.ts tests/main-controlled-database-restore*.test.ts tests/main-restore-knowledge-*.test.ts tests/main-synced-historical-evidence-read.test.ts",
    "test:database-restore-v2-legacy": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-database-restore-v2.ts",
    "test:synced-recovery-boundary": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx --test --test-timeout=120000 tests/main-synced-recovery-boundary.test.ts tests/main-synced-recovery-boundary-integrity.test.ts tests/main-synced-recovery-boundary-legacy.test.ts",
    "test:synced-recovery-legacy-reader": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-synced-recovery-legacy-reader.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@mozilla/readability": "^0.6.0",
    "@types/turndown": "^5.0.6",
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "katex": "^0.16.45",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "parse5": "^8.0.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "quickjs-wasi": "3.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.0.2",
    "turndown": "^7.2.4",
    "undici": "^6.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@swc/core": "^1.11.24",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^10.1.0",
    "electron": "^35.1.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "mermaid": "^12.0.0",
    "semver": "^7.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
